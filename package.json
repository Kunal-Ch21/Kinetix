{
  "name": "kinetix-studio",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Kinetix Studio — native 2D AI motion, vector & character animation suite (100% offline)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "guide": "node scripts/build-guide.mjs",
    "lint": "eslint .",
    "tauri": "tauri",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check-ops": "node scripts/check-ops.mjs",
    "ffmpeg:prepare": "node scripts/prepare-ffmpeg.mjs",
    "tauri:build": "tauri build",
    "tauri:build:bundled": "node scripts/prepare-ffmpeg.mjs && tauri build --config src-tauri/tauri.ffmpeg.conf.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  }
}
